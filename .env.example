# SECUREMON - Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
APP_NAME="SecureMon - Authorized Application Security Assessment Platform"
API_V1_PREFIX=/api

# Database Configuration (PostgreSQL / Supabase / SQLite Fallback)
# For local dev without Postgres, fallback SQLite works seamlessly: sqlite:///./securemon.db
DATABASE_URL=sqlite:///./securemon.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securemon

# Authentication & JWT
JWT_SECRET=securemon-super-secret-jwt-key-sih-2026-ntro-mic-authorized-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Intelligence APIs
# NVD API 2.0 (Optional key - unauthenticated requests are rate-limited but supported)
NVD_API_KEY=
# EPSS (api.first.org) - Public, no key required
EPSS_API_URL=https://api.first.org/data/v1/epss
# CISA KEV - Public JSON catalog
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# OWASP ZAP Local Daemon Configuration
ZAP_ENABLED=false
ZAP_PROXY_URL=http://localhost:8080
ZAP_API_KEY=securemon-zap-api-token-2026

# Storage & Output Paths
REPORT_STORAGE_PATH=./reports_storage

# CORS Settings (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SSRF and Target Allowlist Guard
# Set to true ONLY for demonstration and training against local lab targets (e.g. Juice Shop / localhost test app)
ALLOW_LOCAL_LAB_TARGETS=true
